module

public import EllipticRegularity.Parabolic.Cauchy.Weights.TimeShift
public import EllipticRegularity.Parabolic.WeakSlice.Product
public import PDEFoundation.PDE.DGNM.ProductTest
public import Mathlib.Tactic.FieldSimp
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.Ring

/-!
# Smooth shifted Gaussian weights from truncated distance

The weight uses a mollified truncated distance in space and a globally smooth
positive extension of `t - s + σ` in time. On the forward time half-line this
is exactly the Nash--Aronson weight.
-/

@[expose] public section

namespace PDE.Parabolic.Cauchy.Weights

variable {d : ℕ}

/-- The one-variable Gaussian profile as a function of distance. -/
noncomputable def nashRadiusGaussian (A τ r : ℝ) : ℝ :=
  Real.exp (r ^ 2 / (4 * A * τ))

/-- The smooth exponent generated by a standard mollification of distance to
`K`, truncated at radius `R`. -/
noncomputable def nashSmoothGaussianExponent (K : Set (Vec d)) (R A σ s : ℝ)
    (n : ℕ) (z : Vec d × ℝ) : ℝ :=
  (truncatedDistanceMollify K R n z.1) ^ 2 /
    (4 * A * nashPositiveTimeShift σ (z.2 - s))

/-- The smooth Gaussian weight generated by a standard mollification of
distance to `K`, truncated at radius `R`. -/
noncomputable def nashSmoothGaussianWeight (K : Set (Vec d)) (R A σ s : ℝ)
    (n : ℕ) (z : Vec d × ℝ) : ℝ :=
  Real.exp (nashSmoothGaussianExponent K R A σ s n z)

theorem nashSmoothGaussianExponent_contDiff_one {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) :
    ContDiff ℝ 1 (nashSmoothGaussianExponent K R A σ s n) := by
  have hrho : ContDiff ℝ 1 (truncatedDistanceMollify K R n) := by
    exact (truncatedDistanceMollify_properties hK hR n).1.of_le (by simp)
  have hrho' : ContDiff ℝ 1
      (fun z : Vec d × ℝ => truncatedDistanceMollify K R n z.1) :=
    hrho.comp contDiff_fst
  have hq : ContDiff ℝ 1
      (fun z : Vec d × ℝ => truncatedDistanceMollify K R n z.1 ^ 2) :=
    hrho'.pow 2
  have htime : ContDiff ℝ 1
      (fun z : Vec d × ℝ => nashPositiveTimeShift σ (z.2 - s)) := by
    exact (nashPositiveTimeShift_contDiff_one.comp
      (contDiff_snd.sub contDiff_const))
  have hden : ContDiff ℝ 1
      (fun z : Vec d × ℝ => 4 * A * nashPositiveTimeShift σ (z.2 - s)) :=
    contDiff_const.mul htime
  have hdenne : ∀ z : Vec d × ℝ,
      4 * A * nashPositiveTimeShift σ (z.2 - s) ≠ 0 := by
    intro z
    have hpos := nashPositiveTimeShift_lower (t := z.2 - s) hσ
    have hτpos : 0 < nashPositiveTimeShift σ (z.2 - s) := by
      have hσhalf : 0 < σ / 2 := by positivity
      linarith
    exact mul_ne_zero (mul_ne_zero (by norm_num) hA.ne') hτpos.ne'
  have harg := hq.div hden hdenne
  change ContDiff ℝ 1 (nashSmoothGaussianExponent K R A σ s n)
  exact harg

theorem nashSmoothGaussianWeight_contDiff_one {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) :
    ContDiff ℝ 1 (nashSmoothGaussianWeight K R A σ s n) := by
  change ContDiff ℝ 1 (fun z => Real.exp (nashSmoothGaussianExponent K R A σ s n z))
  exact (nashSmoothGaussianExponent_contDiff_one hK hR hA hσ n).exp

private theorem parTimeDeriv_eq_slice_deriv {F : Vec d × ℝ → ℝ}
    (hF : ContDiff ℝ 1 F) (x : Vec d) (t : ℝ) :
    PDE.parTimeDeriv F (x, t) = deriv (fun r : ℝ => F (x, r)) t := by
  have hpath : HasDerivAt (fun r : ℝ => (x, r)) (0, 1) t := by
    convert (hasDerivAt_const t x).prodMk (hasDerivAt_id t) using 1
    ext <;> simp
  have hcomp :=
    (hF.differentiable (by norm_num) (x, t)).hasFDerivAt.comp_hasDerivAt t hpath
  exact hcomp.deriv.symm

/-- The time derivative of the smooth Gaussian weight on all of space-time.
The smoothed time shift contributes its derivative, which lies in `[0,1]`. -/
theorem parTimeDeriv_nashSmoothGaussianWeight {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) (z : Vec d × ℝ) :
    PDE.parTimeDeriv (nashSmoothGaussianWeight K R A σ s n) z =
      nashSmoothGaussianWeight K R A σ s n z *
        (-(truncatedDistanceMollify K R n z.1 ^ 2 *
          PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)) /
          (4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2)) := by
  have hweight := nashSmoothGaussianWeight_contDiff_one (s := s) hK hR hA hσ n
  let q : ℝ := truncatedDistanceMollify K R n z.1 ^ 2
  let τ : ℝ → ℝ := fun r => nashPositiveTimeShift σ (r - s)
  have hlinear : HasDerivAt (fun r : ℝ => r - s) 1 z.2 :=
    (hasDerivAt_id z.2).sub_const s
  have htheta0 :=
    (nashPositiveTimeShift_hasDerivAt (σ := σ) (t := z.2 - s)).comp
      z.2 hlinear
  have hθ : HasDerivAt τ
      (PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)) z.2 := by
    change HasDerivAt (nashPositiveTimeShift σ ∘ fun r : ℝ => r - s) _ z.2
    simpa only [mul_one] using htheta0
  have hτvalue : τ z.2 = nashPositiveTimeShift σ (z.2 - s) := rfl
  have hτpos : 0 < τ z.2 := by
    have hpos := nashPositiveTimeShift_lower (t := z.2 - s) hσ
    have hσhalf : 0 < σ / 2 := by positivity
    dsimp [τ]
    linarith
  have hden : HasDerivAt (fun r : ℝ => 4 * A * τ r)
      (4 * A * PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)) z.2 := by
    simpa [mul_comm, mul_left_comm, mul_assoc] using hθ.const_mul (4 * A)
  have hdenne : 4 * A * τ z.2 ≠ 0 := by
    positivity
  have harg := (hasDerivAt_const z.2 q).div hden hdenne
  have harg' : HasDerivAt (fun r : ℝ => q / (4 * A * τ r))
      (-(q * PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)) /
        (4 * A * τ z.2 ^ 2)) z.2 := by
    convert harg using 1
    have hAne : A ≠ 0 := ne_of_gt hA
    field_simp [hAne, hdenne]
    ring
  have hexp := (Real.hasDerivAt_exp (q / (4 * A * τ z.2))).comp z.2 harg'
  have hslice : (fun r : ℝ =>
      nashSmoothGaussianWeight K R A σ s n (z.1, r)) =
      fun r => Real.exp (q / (4 * A * τ r)) := by
    funext r
    simp [nashSmoothGaussianWeight, nashSmoothGaussianExponent, q, τ]
  rw [parTimeDeriv_eq_slice_deriv hweight z.1 z.2, hslice]
  change deriv (Real.exp ∘ fun r : ℝ => q / (4 * A * τ r)) z.2 = _
  rw [hexp.deriv]
  simp [nashSmoothGaussianWeight, nashSmoothGaussianExponent, q, τ]

/-- The mollified distance weight is at least one and has a global upper bound
depending only on the truncation radius and the positive shift. -/
theorem nashSmoothGaussianWeight_bounds {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) (z : Vec d × ℝ) :
    1 ≤ nashSmoothGaussianWeight K R A σ s n z ∧
      nashSmoothGaussianWeight K R A σ s n z ≤
        Real.exp (R ^ 2 / (2 * A * σ)) := by
  have hprops := truncatedDistanceMollify_properties hK hR n
  have hρlo := (hprops.2.1 z.1).1
  have hρhi := (hprops.2.1 z.1).2
  have hτ := nashPositiveTimeShift_lower (t := z.2 - s) hσ
  have hτpos : 0 < nashPositiveTimeShift σ (z.2 - s) := by
    have hσ2 : 0 < σ / 2 := by positivity
    linarith
  have hnumlo : 0 ≤ truncatedDistanceMollify K R n z.1 ^ 2 := sq_nonneg _
  have hnumhi : truncatedDistanceMollify K R n z.1 ^ 2 ≤ R ^ 2 := by
    exact pow_le_pow_left₀ hρlo hρhi 2
  have hsmall : 0 < 2 * A * σ := by positivity
  have hbig : 0 < 4 * A * nashPositiveTimeShift σ (z.2 - s) := by positivity
  have hdenle : 2 * A * σ ≤
      4 * A * nashPositiveTimeShift σ (z.2 - s) := by
    nlinarith [mul_le_mul_of_nonneg_left hτ (show 0 ≤ 4 * A from by positivity)]
  have hexpLo : 0 ≤
      truncatedDistanceMollify K R n z.1 ^ 2 /
        (4 * A * nashPositiveTimeShift σ (z.2 - s)) :=
    div_nonneg hnumlo hbig.le
  have hexpHi :
      truncatedDistanceMollify K R n z.1 ^ 2 /
        (4 * A * nashPositiveTimeShift σ (z.2 - s)) ≤ R ^ 2 / (2 * A * σ) := by
    calc
      _ ≤ R ^ 2 / (4 * A * nashPositiveTimeShift σ (z.2 - s)) :=
        div_le_div_of_nonneg_right hnumhi hbig.le
      _ ≤ R ^ 2 / (2 * A * σ) :=
        div_le_div_of_nonneg_left (sq_nonneg R) hsmall hdenle
  constructor
  · rw [show (1 : ℝ) = Real.exp 0 by rw [Real.exp_zero]]
    exact Real.exp_le_exp.mpr hexpLo
  · exact Real.exp_le_exp.mpr hexpHi

/-- Uniform global bound for the time derivative of the mollified Gaussian
weight. -/
theorem nashSmoothGaussianWeight_timeDeriv_bound {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) (z : Vec d × ℝ) :
    |PDE.parTimeDeriv (nashSmoothGaussianWeight K R A σ s n) z| ≤
      Real.exp (R ^ 2 / (2 * A * σ)) * R ^ 2 / (A * σ ^ 2) := by
  have hweight := nashSmoothGaussianWeight_bounds (s := s) hK hR hA hσ n z
  have hprops := truncatedDistanceMollify_properties hK hR n
  have hρlo := (hprops.2.1 z.1).1
  have hρhi := (hprops.2.1 z.1).2
  have hτ := nashPositiveTimeShift_lower (t := z.2 - s) hσ
  have hτpos : 0 < nashPositiveTimeShift σ (z.2 - s) := by
    have hσ2 : 0 < σ / 2 := by positivity
    linarith
  have hstep := PDE.abs_smoothPositivePartStep_le_one
    (-σ / 4) (σ / 8) (z.2 - s)
  have hnum : |truncatedDistanceMollify K R n z.1 ^ 2 *
      PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)| ≤ R ^ 2 := by
    rw [abs_mul, abs_of_nonneg (sq_nonneg _)]
    calc
      truncatedDistanceMollify K R n z.1 ^ 2 *
          |PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)| ≤
        truncatedDistanceMollify K R n z.1 ^ 2 * 1 :=
          mul_le_mul_of_nonneg_left hstep (sq_nonneg _)
      _ ≤ R ^ 2 := by simpa using pow_le_pow_left₀ hρlo hρhi 2
  have hden : A * σ ^ 2 ≤
      4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2 := by
    have hsquare : (σ / 2) ^ 2 ≤ nashPositiveTimeShift σ (z.2 - s) ^ 2 :=
      pow_le_pow_left₀ (by positivity) hτ 2
    nlinarith [mul_le_mul_of_nonneg_left hsquare hA.le]
  rw [parTimeDeriv_nashSmoothGaussianWeight hK hR hA hσ n z]
  rw [abs_mul, abs_of_nonneg (le_trans (by positivity) hweight.1)]
  have hfrac :
      |-(truncatedDistanceMollify K R n z.1 ^ 2 *
          PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)) /
          (4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2)| ≤
        R ^ 2 / (A * σ ^ 2) := by
    rw [abs_div, abs_neg]
    have hdenpos : 0 < 4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2 := by positivity
    rw [abs_of_pos hdenpos]
    calc
      |truncatedDistanceMollify K R n z.1 ^ 2 *
          PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)| /
          (4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2) ≤
        R ^ 2 / (4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2) :=
          div_le_div_of_nonneg_right hnum hdenpos.le
      _ ≤ R ^ 2 / (A * σ ^ 2) :=
        div_le_div_of_nonneg_left (sq_nonneg R) (by positivity) hden
  calc
    _ = nashSmoothGaussianWeight K R A σ s n z *
        |-(truncatedDistanceMollify K R n z.1 ^ 2 *
          PDE.smoothPositivePartStep (-σ / 4) (σ / 8) (z.2 - s)) /
          (4 * A * nashPositiveTimeShift σ (z.2 - s) ^ 2)| := by
            rfl
    _ ≤ Real.exp (R ^ 2 / (2 * A * σ)) * (R ^ 2 / (A * σ ^ 2)) :=
      mul_le_mul hweight.2 hfrac (abs_nonneg _) (by positivity)
    _ = Real.exp (R ^ 2 / (2 * A * σ)) * R ^ 2 / (A * σ ^ 2) := by ring

/-- The exponent's Euclidean spatial gradient is bounded pointwise by the
truncated distance divided by its parabolic scale. -/
private theorem parSpaceGrad_eq_classicalGradient_slice_aux
    {F : Vec d × ℝ → ℝ} (hF : ContDiff ℝ 1 F) (x : Vec d) (t : ℝ) :
    parSpaceGrad F (x, t) = classicalGradient (fun y : Vec d => F (y, t)) x := by
  ext i
  have h1 : HasFDerivAt F (fderiv ℝ F (x, t)) (x, t) :=
    (hF.differentiable (by norm_num) (x, t)).hasFDerivAt
  have h2 : HasFDerivAt (fun y : Vec d => ((y, t) : Vec d × ℝ))
      ((ContinuousLinearMap.id ℝ (Vec d)).prod 0) x :=
    (hasFDerivAt_id x).prodMk (hasFDerivAt_const t x)
  have h3 : fderiv ℝ (fun y : Vec d => F (y, t)) x =
      (fderiv ℝ F (x, t)).comp ((ContinuousLinearMap.id ℝ (Vec d)).prod 0) :=
    (h1.comp x h2).fderiv
  unfold parSpaceGrad classicalGradient
  rw [h3]
  simp

theorem nashSmoothGaussianExponent_spatialGrad_bound {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s t : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) (x : Vec d) :
    vecEuclideanNorm
      (parSpaceGrad (nashSmoothGaussianExponent K R A σ s n) (x, t)) ≤
        truncatedDistanceMollify K R n x /
          (2 * A * nashPositiveTimeShift σ (t - s)) := by
  let ρ : Vec d → ℝ := truncatedDistanceMollify K R n
  let D : ℝ := 4 * A * nashPositiveTimeShift σ (t - s)
  have hρsmooth : ContDiff ℝ (⊤ : ℕ∞) ρ := by
    simpa [ρ] using (truncatedDistanceMollify_properties hK hR n).1
  have hρrange := (truncatedDistanceMollify_properties hK hR n).2.1 x
  have hρgrad := (truncatedDistanceMollify_properties hK hR n).2.2.1 x
  have hτ := nashPositiveTimeShift_lower (t := t - s) hσ
  have hτpos : 0 < nashPositiveTimeShift σ (t - s) := by
    have hσhalf : 0 < σ / 2 := by positivity
    linarith
  have hDpos : 0 < D := by dsimp [D]; positivity
  have hDne : D ≠ 0 := ne_of_gt hDpos
  have hqgrad : classicalGradient (fun y : Vec d => ρ y ^ 2) x =
      (2 * ρ x) • classicalGradient ρ x :=
    PDE.DGNM.classicalGradient_sq hρsmooth x
  have hsliceEq : (fun y : Vec d =>
      nashSmoothGaussianExponent K R A σ s n (y, t)) =
      fun y => ρ y ^ 2 / D := by
    funext y
    simp [nashSmoothGaussianExponent, ρ, D]
  have hgradSlice : classicalGradient
      (fun y : Vec d => nashSmoothGaussianExponent K R A σ s n (y, t)) x =
      (D⁻¹) • classicalGradient (fun y : Vec d => ρ y ^ 2) x := by
    rw [hsliceEq]
    have hdiff : DifferentiableAt ℝ (fun y : Vec d => ρ y ^ 2) x :=
      (hρsmooth.pow 2).contDiffAt.differentiableAt (by simp)
    have hfun : (fun y : Vec d => ρ y ^ 2 / D) =
        fun y => D⁻¹ * ρ y ^ 2 := by
      funext y
      rw [div_eq_mul_inv, mul_comm]
    ext i
    simp only [classicalGradient_apply, Pi.smul_apply, smul_eq_mul]
    rw [hfun, fderiv_const_mul hdiff]
    simp only [smul_apply, smul_eq_mul]
  have hgradExponent : parSpaceGrad
      (nashSmoothGaussianExponent K R A σ s n) (x, t) =
        (D⁻¹) • ((2 * ρ x) • classicalGradient ρ x) := by
    rw [parSpaceGrad_eq_classicalGradient_slice_aux
      (nashSmoothGaussianExponent_contDiff_one hK hR hA hσ n) x t,
      hgradSlice, hqgrad]
  have hnorm := vecEuclideanNorm_smul (D⁻¹)
      ((2 * ρ x) • classicalGradient ρ x)
  have hnorm' := vecEuclideanNorm_smul (2 * ρ x) (classicalGradient ρ x)
  have hscalePos : 0 < 2 * A * nashPositiveTimeShift σ (t - s) := by
    positivity
  have hdesired : 0 ≤ ρ x / (2 * A * nashPositiveTimeShift σ (t - s)) :=
    div_nonneg hρrange.1 hscalePos.le
  rw [hgradExponent]
  rw [hnorm, hnorm']
  rw [abs_of_nonneg (inv_nonneg.mpr hDpos.le),
    abs_of_nonneg (mul_nonneg (by norm_num) hρrange.1)]
  have hcombine : D⁻¹ * (2 * ρ x) =
      ρ x / (2 * A * nashPositiveTimeShift σ (t - s)) := by
    dsimp [D]
    field_simp [ne_of_gt hA, ne_of_gt hτpos]
    ring
  have hreassoc : D⁻¹ * (2 * ρ x * vecEuclideanNorm (classicalGradient ρ x)) =
      (D⁻¹ * (2 * ρ x)) * vecEuclideanNorm (classicalGradient ρ x) := by ring
  rw [hreassoc, hcombine]
  calc
    ρ x / (2 * A * nashPositiveTimeShift σ (t - s)) *
        vecEuclideanNorm (classicalGradient ρ x) ≤
      ρ x / (2 * A * nashPositiveTimeShift σ (t - s)) * 1 :=
        mul_le_mul_of_nonneg_left hρgrad hdesired
    _ = ρ x / (2 * A * nashPositiveTimeShift σ (t - s)) := by ring

theorem hasDerivAt_nashRadiusGaussian {A τ r : ℝ} (hAτ : 0 < A * τ) :
    HasDerivAt (nashRadiusGaussian A τ)
      (nashRadiusGaussian A τ r * (r / (2 * A * τ))) r := by
  have hden : 4 * A * τ ≠ 0 := by
    have heq : 4 * A * τ = 4 * (A * τ) := by ring
    rw [heq]
    exact mul_ne_zero (by norm_num) hAτ.ne'
  have hsq : HasDerivAt (fun x : ℝ => x ^ 2) (2 * r) r := by
    convert (hasDerivAt_id r).pow 2 using 1
    · rfl
    · simp [mul_comm]
  have harg : HasDerivAt (fun x : ℝ => x ^ 2 / (4 * A * τ))
      (r / (2 * A * τ)) r := by
    convert hsq.div_const (4 * A * τ) using 1
    field_simp [hden]
    ring
  change HasDerivAt (fun x : ℝ => Real.exp (x ^ 2 / (4 * A * τ)))
    (Real.exp (r ^ 2 / (4 * A * τ)) * (r / (2 * A * τ))) r
  exact (Real.hasDerivAt_exp (r ^ 2 / (4 * A * τ))).comp r harg

/-- The radius profile has a dimensionally explicit Lipschitz bound on the
truncated interval `[0,R]`. -/
theorem nashRadiusGaussian_deriv_bound {A τ σ R B r : ℝ}
    (hA : 0 < A) (hτ : σ / 2 ≤ τ) (hσ : 0 < σ) (hR : 0 ≤ R)
    (hB : Real.exp (R ^ 2 / (2 * A * σ)) ≤ B)
    (hr : 0 ≤ r) (hrR : r ≤ R) :
    |deriv (nashRadiusGaussian A τ) r| ≤ B * R / (A * σ) := by
  have hτpos : 0 < τ := by
    have hσ2 : 0 < σ / 2 := by positivity
    linarith
  have hAτ : 0 < A * τ := mul_pos hA hτpos
  have hden : 0 < 4 * A * τ := by positivity
  have hdenlo : 2 * A * σ ≤ 4 * A * τ := by nlinarith
  have hexp : r ^ 2 / (4 * A * τ) ≤ R ^ 2 / (2 * A * σ) := by
    calc
      _ ≤ R ^ 2 / (4 * A * τ) :=
        div_le_div_of_nonneg_right ((sq_le_sq₀ hr hR).2 hrR) hden.le
      _ ≤ R ^ 2 / (2 * A * σ) :=
        div_le_div_of_nonneg_left (sq_nonneg R) (by positivity) hdenlo
  have hfac : r / (2 * A * τ) ≤ R / (A * σ) := by
    have hden' : 0 < 2 * A * τ := by positivity
    have hden'' : 0 < A * σ := by positivity
    have hdenle : A * σ ≤ 2 * A * τ := by nlinarith
    calc
      r / (2 * A * τ) ≤ R / (2 * A * τ) :=
        div_le_div_of_nonneg_right hrR hden'.le
      _ ≤ R / (A * σ) :=
        div_le_div_of_nonneg_left hR hden'' hdenle
  have hderiv := hasDerivAt_nashRadiusGaussian (r := r) hAτ
  have hformula : deriv (nashRadiusGaussian A τ) r =
      nashRadiusGaussian A τ r * (r / (2 * A * τ)) := hderiv.deriv
  have hprofnonneg : 0 ≤ nashRadiusGaussian A τ r := by
    exact (Real.exp_pos _).le
  have hfacnonneg : 0 ≤ r / (2 * A * τ) := by positivity
  rw [hformula, abs_of_nonneg (mul_nonneg hprofnonneg hfacnonneg)]
  calc
    nashRadiusGaussian A τ r * (r / (2 * A * τ)) ≤ B * (R / (A * σ)) := by
      apply mul_le_mul
      · unfold nashRadiusGaussian
        exact Real.exp_le_exp.mpr hexp |>.trans hB
      · exact hfac
      · exact hfacnonneg
      · exact le_trans (Real.exp_nonneg _) hB
    _ = B * R / (A * σ) := by ring

private theorem nashRadiusGaussian_slope_bound {A τ σ R B a b : ℝ}
    (hA : 0 < A) (hτ : σ / 2 ≤ τ) (hσ : 0 < σ) (hR : 0 ≤ R)
    (hB : Real.exp (R ^ 2 / (2 * A * σ)) ≤ B)
    (hab : a < b) (ha : 0 ≤ a) (hb : b ≤ R) :
    |nashRadiusGaussian A τ b - nashRadiusGaussian A τ a| ≤
      (B * R / (A * σ)) * (b - a) := by
  have hcont : ContinuousOn (nashRadiusGaussian A τ) (Set.Icc a b) := by
    unfold nashRadiusGaussian
    exact (Real.continuous_exp.comp
      ((continuous_id.pow 2).div_const (4 * A * τ))).continuousOn
  have hderiv : ∀ x ∈ Set.Ioo a b,
      HasDerivAt (nashRadiusGaussian A τ) (deriv (nashRadiusGaussian A τ) x) x := by
    intro x hx
    have hτpos : 0 < τ := by
      have hσ2 : 0 < σ / 2 := by positivity
      linarith
    have hbase := hasDerivAt_nashRadiusGaussian (r := x) (mul_pos hA hτpos)
    exact hbase.congr_deriv hbase.deriv.symm
  obtain ⟨x, hx, hslope⟩ := exists_hasDerivAt_eq_slope (nashRadiusGaussian A τ)
    (deriv (nashRadiusGaussian A τ)) hab hcont hderiv
  have hx0 : 0 ≤ x := le_trans ha hx.1.le
  have hxR : x ≤ R := le_trans hx.2.le hb
  have hderivbound := nashRadiusGaussian_deriv_bound hA hτ hσ hR hB hx0 hxR
  have hslopebound : |(nashRadiusGaussian A τ b - nashRadiusGaussian A τ a) /
      (b - a)| ≤ B * R / (A * σ) := by
    rw [← hslope]
    exact hderivbound
  have hdenpos : 0 < b - a := sub_pos.mpr hab
  have hmul := mul_le_mul_of_nonneg_right hslopebound hdenpos.le
  have habsEq : |nashRadiusGaussian A τ b - nashRadiusGaussian A τ a| =
      |(nashRadiusGaussian A τ b - nashRadiusGaussian A τ a) / (b - a)| *
        (b - a) := by
    rw [abs_div, abs_of_pos hdenpos]
    field_simp [ne_of_gt hdenpos]
  rw [habsEq]
  nlinarith

/-- The radial Gaussian profile is Lipschitz on the range of the truncated
distance. -/
theorem nashRadiusGaussian_lipschitzOn {A τ σ R B r₁ r₂ : ℝ}
    (hA : 0 < A) (hτ : σ / 2 ≤ τ) (hσ : 0 < σ) (hR : 0 ≤ R)
    (hB : Real.exp (R ^ 2 / (2 * A * σ)) ≤ B)
    (hr₁ : 0 ≤ r₁) (hr₁R : r₁ ≤ R)
    (hr₂ : 0 ≤ r₂) (hr₂R : r₂ ≤ R) :
    |nashRadiusGaussian A τ r₁ - nashRadiusGaussian A τ r₂| ≤
      (B * R / (A * σ)) * |r₁ - r₂| := by
  by_cases hlt : r₁ < r₂
  · have h := nashRadiusGaussian_slope_bound hA hτ hσ hR hB hlt hr₁ hr₂R
    calc
      |nashRadiusGaussian A τ r₁ - nashRadiusGaussian A τ r₂| =
          |nashRadiusGaussian A τ r₂ - nashRadiusGaussian A τ r₁| :=
        abs_sub_comm _ _
      _ ≤ (B * R / (A * σ)) * (r₂ - r₁) := h
      _ = (B * R / (A * σ)) * |r₁ - r₂| := by
        rw [abs_of_neg (sub_neg.mpr hlt)]
        ring
  · by_cases heq : r₁ = r₂
    · simp [heq]
    · have hlt' : r₂ < r₁ := lt_of_le_of_ne (le_of_not_gt hlt) (Ne.symm heq)
      have h := nashRadiusGaussian_slope_bound hA hτ hσ hR hB hlt' hr₂ hr₁R
      rw [abs_of_pos (sub_pos.mpr hlt')]
      exact h

theorem parSpaceGrad_eq_classicalGradient_slice
    {F : Vec d × ℝ → ℝ} (hF : ContDiff ℝ 1 F) (x : Vec d) (t : ℝ) :
    parSpaceGrad F (x, t) = classicalGradient (fun y : Vec d => F (y, t)) x := by
  ext i
  have h1 : HasFDerivAt F (fderiv ℝ F (x, t)) (x, t) :=
    (hF.differentiable (by norm_num) (x, t)).hasFDerivAt
  have h2 : HasFDerivAt (fun y : Vec d => ((y, t) : Vec d × ℝ))
      ((ContinuousLinearMap.id ℝ (Vec d)).prod 0) x :=
    (hasFDerivAt_id x).prodMk (hasFDerivAt_const t x)
  have h3 : fderiv ℝ (fun y : Vec d => F (y, t)) x =
      (fderiv ℝ F (x, t)).comp ((ContinuousLinearMap.id ℝ (Vec d)).prod 0) :=
    (h1.comp x h2).fderiv
  unfold parSpaceGrad classicalGradient
  rw [h3]
  simp

/-- Chain rule for the spatial derivative of the smooth Gaussian weight. -/
theorem parSpaceGrad_nashSmoothGaussianWeight_eq {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) (z : Vec d × ℝ) :
    parSpaceGrad (nashSmoothGaussianWeight K R A σ s n) z =
      nashSmoothGaussianWeight K R A σ s n z •
        parSpaceGrad (nashSmoothGaussianExponent K R A σ s n) z := by
  let H : Vec d → ℝ := fun y => nashSmoothGaussianExponent K R A σ s n (y, z.2)
  have hWeight := nashSmoothGaussianWeight_contDiff_one (s := s) hK hR hA hσ n
  have hExponent := nashSmoothGaussianExponent_contDiff_one (s := s) hK hR hA hσ n
  have hH : ContDiff ℝ 1 H := by
    dsimp [H]
    exact hExponent.comp (contDiff_id.prodMk contDiff_const)
  have hHderiv : HasFDerivAt H (fderiv ℝ H z.1) z.1 :=
    (hH.differentiable (by norm_num) z.1).hasFDerivAt
  have hchain := (Real.hasDerivAt_exp (H z.1)).comp_hasFDerivAt z.1 hHderiv
  have hderiv : fderiv ℝ (fun y : Vec d =>
      nashSmoothGaussianWeight K R A σ s n (y, z.2)) z.1 =
      Real.exp (H z.1) • fderiv ℝ H z.1 := by
    change fderiv ℝ (fun y : Vec d => Real.exp (H y)) z.1 = _
    exact hchain.fderiv
  rw [parSpaceGrad_eq_classicalGradient_slice hWeight z.1 z.2,
    parSpaceGrad_eq_classicalGradient_slice hExponent z.1 z.2]
  ext i
  simp only [classicalGradient_apply]
  rw [hderiv]
  simp [H, nashSmoothGaussianWeight, smul_apply]

/-- The spatial gradient of the smooth Gaussian weight has the expected
uniform bound, using the Euclidean Lipschitz constant of the mollified
distance. -/
theorem nashSmoothGaussianWeight_spatialGrad_bound {K : Set (Vec d)}
    (hK : K.Nonempty) {R A σ s t : ℝ} (hR : 0 ≤ R) (hA : 0 < A)
    (hσ : 0 < σ) (n : ℕ) (x : Vec d) :
    vecEuclideanNorm
      (parSpaceGrad (nashSmoothGaussianWeight K R A σ s n) (x, t)) ≤
        Real.exp (R ^ 2 / (2 * A * σ)) * R / (A * σ) := by
  have hweight := nashSmoothGaussianWeight_contDiff_one (s := s) hK hR hA hσ n
  have hρLip := truncatedDistanceMollify_eucLip hK hR n
  have hρProps := truncatedDistanceMollify_properties hK hR n
  have hρrange := hρProps.2.1
  have hτ := nashPositiveTimeShift_lower (t := t - s) hσ
  have hLnonneg : 0 ≤ Real.exp (R ^ 2 / (2 * A * σ)) * R / (A * σ) := by
    positivity
  have hsliceLip : PDE.Ch4Infra.EucLip
      (Real.exp (R ^ 2 / (2 * A * σ)) * R / (A * σ))
      (fun y : Vec d => nashSmoothGaussianWeight K R A σ s n (y, t)) := by
    intro y₁ y₂
    have hprof₁ : nashSmoothGaussianWeight K R A σ s n (y₁, t) =
        nashRadiusGaussian A (nashPositiveTimeShift σ (t - s))
          (truncatedDistanceMollify K R n y₁) := by
      simp [nashSmoothGaussianWeight, nashSmoothGaussianExponent, nashRadiusGaussian]
    have hprof₂ : nashSmoothGaussianWeight K R A σ s n (y₂, t) =
        nashRadiusGaussian A (nashPositiveTimeShift σ (t - s))
          (truncatedDistanceMollify K R n y₂) := by
      simp [nashSmoothGaussianWeight, nashSmoothGaussianExponent, nashRadiusGaussian]
    have hr₁ := hρrange y₁
    have hr₂ := hρrange y₂
    have hρdist : |truncatedDistanceMollify K R n y₁ -
        truncatedDistanceMollify K R n y₂| ≤ vecEuclideanNorm (y₁ - y₂) := by
      simpa using hρLip y₁ y₂
    change |nashSmoothGaussianWeight K R A σ s n (y₁, t) -
      nashSmoothGaussianWeight K R A σ s n (y₂, t)| ≤ _
    rw [hprof₁, hprof₂]
    calc
      |nashRadiusGaussian A (nashPositiveTimeShift σ (t - s))
          (truncatedDistanceMollify K R n y₁) -
        nashRadiusGaussian A (nashPositiveTimeShift σ (t - s))
          (truncatedDistanceMollify K R n y₂)| ≤
        (Real.exp (R ^ 2 / (2 * A * σ)) * R / (A * σ)) *
          |truncatedDistanceMollify K R n y₁ - truncatedDistanceMollify K R n y₂| :=
            nashRadiusGaussian_lipschitzOn hA hτ hσ hR le_rfl
              hr₁.1 hr₁.2 hr₂.1 hr₂.2
      _ ≤ (Real.exp (R ^ 2 / (2 * A * σ)) * R / (A * σ)) *
          vecEuclideanNorm (y₁ - y₂) :=
            mul_le_mul_of_nonneg_left hρdist hLnonneg
  have hspace : ContDiff ℝ 1
      (fun y : Vec d => nashSmoothGaussianWeight K R A σ s n (y, t)) :=
    hweight.comp (contDiff_id.prodMk contDiff_const)
  have hdiff := hspace.differentiable (by norm_num) x
  have hgrad := hsliceLip.vecEuclideanNorm_classicalGradient_le hLnonneg hdiff
  rw [parSpaceGrad_eq_classicalGradient_slice hweight x t]
  exact hgrad

end PDE.Parabolic.Cauchy.Weights
