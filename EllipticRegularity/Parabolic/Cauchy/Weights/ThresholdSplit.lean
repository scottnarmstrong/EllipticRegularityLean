module

public import EllipticRegularity.Parabolic.Cauchy.Weights.PolynomialDensity
public import Mathlib.Tactic.FieldSimp
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.Ring

/-!
# Threshold algebra in the weighted Nash estimate

The integrated weighted energy identity has a signed loss term.  Below the
Gaussian threshold its positive contribution is controlled by the unweighted
square density; above the threshold it is nonpositive.  This module records
that pointwise split for the mollified, truncated, shifted weight.
-/

@[expose] public section

namespace PDE.Parabolic.Cauchy.Weights

variable {d : ℕ}

/-- Scalar form of the Nash threshold split, with `κ = 2δm`. -/
theorem nash_threshold_split {δ κ m X : ℝ} (hδ : 0 < δ)
    (hm : 0 ≤ m) (hX : 0 ≤ X) (hκ : κ = 2 * δ * m) :
    (κ - 2 * δ * X) * Real.exp (2 * X) ≤ κ * Real.exp (2 * m) := by
  have h := nashGaussianWeight_split_bound hδ hm hX
  calc
    (κ - 2 * δ * X) * Real.exp (2 * X) =
        2 * δ * (m - X) * Real.exp (2 * X) := by rw [hκ]; ring
    _ ≤ 2 * δ * m * Real.exp (2 * m) := h
    _ = κ * Real.exp (2 * m) := by rw [hκ]

/-- On the forward time slab the square of the product weight is exactly the
Nash time power times the Gaussian generated by the mollified truncated
distance. -/
theorem nashPolynomialGaussianWeight_sq_on_forward_slab {H σ s A : ℝ}
    {K : Set (Vec d)} (hH : 0 < H) (hσ : 0 < σ) (hA : 0 < A)
    (R : ℝ) (n : ℕ) (z : Vec d × ℝ)
    (hz₀ : s ≤ z.2) (hzH : z.2 ≤ s + H) :
    nashPolynomialGaussianWeight (d := d) H K R A σ s n z ^ 2 =
      (nashPositiveTimeShift σ (z.2 - s)) ^ (((d : ℝ) + 2) / 2) *
        Real.exp (truncatedDistanceMollify K R n z.1 ^ 2 /
          (2 * A * nashPositiveTimeShift σ (z.2 - s))) := by
  let τ := nashPositiveTimeShift σ (z.2 - s)
  let α : ℝ := ((d : ℝ) + 2) / 4
  let κ : ℝ := ((d : ℝ) + 2) / 2
  let ρ := truncatedDistanceMollify K R n z.1
  have hτeq : τ = z.2 - s + σ := by
    dsimp [τ]
    exact nashPositiveTimeShift_eq_add hσ (sub_nonneg.mpr hz₀)
  have hτpos : 0 < τ := by rw [hτeq]; positivity
  have htheta : nashPolynomialTimeSpacetime (d := d) H σ s z = τ ^ α := by
    dsimp [nashPolynomialTimeSpacetime, τ]
    rw [nashPolynomialTimeFactor_eq_rpow hH hσ (sub_nonneg.mpr hz₀)
      (by linarith : z.2 - s ≤ H)]
  have hgaussian : nashSmoothGaussianWeight K R A σ s n z =
      Real.exp (ρ ^ 2 / (4 * A * τ)) := rfl
  have hκ : κ = 2 * α := by dsimp [κ, α]; ring
  have hsq :
      (τ ^ α * Real.exp (ρ ^ 2 / (4 * A * τ))) ^ 2 =
        τ ^ κ * Real.exp (ρ ^ 2 / (2 * A * τ)) := by
    rw [mul_pow]
    calc
      (τ ^ α) ^ 2 * Real.exp (ρ ^ 2 / (4 * A * τ)) ^ 2 =
          τ ^ (α * 2) * Real.exp
            (2 * (ρ ^ 2 / (4 * A * τ))) := by
              rw [← Real.rpow_natCast (τ ^ α) 2, ← Real.rpow_mul hτpos.le,
                ← Real.rpow_natCast (Real.exp (ρ ^ 2 / (4 * A * τ))) 2,
                ← Real.exp_mul]
              ring_nf
      _ = τ ^ κ * Real.exp (ρ ^ 2 / (2 * A * τ)) := by
        rw [show α * 2 = κ by rw [hκ]; ring]
        congr 2
        · field_simp [ne_of_gt hA, ne_of_gt hτpos]
          ring
  change (nashPolynomialTimeSpacetime (d := d) H σ s z *
      nashSmoothGaussianWeight K R A σ s n z) ^ 2 = _
  rw [htheta, hgaussian, hsq]

/-- Pointwise loss bound for the smooth Nash weight on its forward slab.
The coefficient is allowed to be negative; the threshold split bounds its
negative twice by the time power times the unweighted square density. -/
theorem nashPolynomialGaussianLoss_split_pointwise {H Lam A σ s : ℝ}
    {K : Set (Vec d)} (hK : K.Nonempty) (hH : 0 < H)
    (hLam : 1 ≤ Lam) (hA : Lam < A) (hσ : 0 < σ)
    {R : ℝ} (hR : 0 ≤ R) (n : ℕ) (z : Vec d × ℝ)
    (hz₀ : s ≤ z.2) (hzH : z.2 ≤ s + H) :
    -2 * nashPolynomialGaussianLossCoefficient (d := d) H K R Lam A σ s n z ≤
      (((d : ℝ) + 2) / 2) *
        Real.exp (2 * ((((d : ℝ) + 2) / 2) / (2 * (1 - Lam / A)))) *
        (nashPositiveTimeShift σ (z.2 - s)) ^ ((((d : ℝ) + 2) / 2) - 1) := by
  let κ : ℝ := ((d : ℝ) + 2) / 2
  let δ : ℝ := 1 - Lam / A
  let m : ℝ := κ / (2 * δ)
  let τ : ℝ := nashPositiveTimeShift σ (z.2 - s)
  let ρ : ℝ := truncatedDistanceMollify K R n z.1
  let ψ : ℝ := ρ ^ 2 / (4 * A * τ)
  let α : ℝ := ((d : ℝ) + 2) / 4
  let ξ : Vec d × ℝ → ℝ := nashPolynomialGaussianWeight (d := d) H K R A σ s n
  change -2 * nashPolynomialGaussianLossCoefficient (d := d) H K R Lam A σ s n z ≤
      κ * Real.exp (2 * m) * τ ^ (κ - 1)
  have hApos : 0 < A := lt_of_le_of_lt (by linarith) hA
  have hδ : 0 < δ := by
    have hratio : Lam / A < 1 := (div_lt_one₀ hApos).2 hA
    dsimp [δ]
    linarith
  have hτeq : τ = z.2 - s + σ := by
    dsimp [τ]
    exact nashPositiveTimeShift_eq_add hσ (sub_nonneg.mpr hz₀)
  have hτpos : 0 < τ := by rw [hτeq]; positivity
  have hρnonneg : 0 ≤ ρ :=
    (truncatedDistanceMollify_properties hK hR n).2.1 z.1 |>.1
  have hψnonneg : 0 ≤ ψ := by
    dsimp [ψ]
    positivity
  have hα : α = κ / 2 := by dsimp [α, κ]; ring
  have hκα : κ = 2 * α := by rw [hα]; ring
  have hmnonneg : 0 ≤ m := by
    dsimp [m]
    apply div_nonneg
    · dsimp [κ]
      positivity
    · positivity
  have hκsplit : κ = 2 * δ * m := by
    dsimp [m]
    field_simp [ne_of_gt hδ]
  have htheta : nashPolynomialTimeSpacetime (d := d) H σ s z = τ ^ α := by
    dsimp [nashPolynomialTimeSpacetime, τ]
    rw [nashPolynomialTimeFactor_eq_rpow hH hσ (sub_nonneg.mpr hz₀)
      (by linarith : z.2 - s ≤ H)]
  have hgaussian : nashSmoothGaussianWeight K R A σ s n z = Real.exp ψ := by
    rfl
  have hξ : ξ z = τ ^ α * Real.exp ψ := by
    dsimp [ξ, nashPolynomialGaussianWeight]
    rw [htheta, hgaussian]
  have hξsq : ξ z ^ 2 = τ ^ κ * Real.exp (2 * ψ) := by
    rw [hξ, mul_pow]
    calc
      (τ ^ α) ^ 2 * Real.exp ψ ^ 2 =
          τ ^ (α * 2) * Real.exp (2 * ψ) := by
            rw [← Real.rpow_natCast (τ ^ α) 2, ← Real.rpow_mul hτpos.le,
              ← Real.rpow_natCast (Real.exp ψ) 2, ← Real.exp_mul]
            ring_nf
      _ = τ ^ κ * Real.exp (2 * ψ) := by
        rw [show α * 2 = κ by rw [hκα]; ring]
  have hτne : τ ≠ 0 := ne_of_gt hτpos
  have hlossEq :
      -2 * nashPolynomialGaussianLossCoefficient (d := d) H K R Lam A σ s n z =
        τ ^ (κ - 1) * ((κ - 2 * δ * ψ) * Real.exp (2 * ψ)) := by
    change -2 * (ξ z ^ 2 * ((δ * ψ - α) / τ)) =
      τ ^ (κ - 1) * ((κ - 2 * δ * ψ) * Real.exp (2 * ψ))
    rw [hξsq]
    field_simp [hτne]
    have hpow : τ * τ ^ (κ - 1) = τ ^ κ := by
      calc
        τ * τ ^ (κ - 1) = τ ^ (1 : ℝ) * τ ^ (κ - 1) := by
          simp only [Real.rpow_one]
        _ = τ ^ (1 + (κ - 1)) := by rw [← Real.rpow_add hτpos]
        _ = τ ^ κ := by congr 1; ring
    rw [hpow, hκα]
    ring
  rw [hlossEq]
  have hsplit := nash_threshold_split hδ hmnonneg hψnonneg hκsplit
  have hpow : 0 ≤ τ ^ (κ - 1) := Real.rpow_nonneg hτpos.le _
  calc
    τ ^ (κ - 1) * ((κ - 2 * δ * ψ) * Real.exp (2 * ψ)) ≤
        τ ^ (κ - 1) * (κ * Real.exp (2 * m)) :=
      mul_le_mul_of_nonneg_left hsplit hpow
    _ = κ * Real.exp (2 * m) * τ ^ (κ - 1) := by ring

end PDE.Parabolic.Cauchy.Weights
