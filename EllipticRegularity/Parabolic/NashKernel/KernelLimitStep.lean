module

public import EllipticRegularity.Parabolic.NashKernel.DyadicCube
public import Mathlib.Probability.Martingale.Convergence
public import Mathlib.MeasureTheory.Integral.DominatedConvergence

/-!
# Dyadic step kernels and their martingale property

For a family `T n k : Vec d → ℝ` indexed by dyadic cubes, the step kernel at level `n` is
`stepKernel T n x y = 2^{nd} * T n (idx n y) x`.  At a point `x` where the data is *good*
(the pointwise bounds `0 ≤ T Q x ≤ M vol Q` and the additivity on children), the sequence
`n ↦ stepKernel T n x` is a bounded martingale in `y` with respect to the dyadic filtration, on
each finite window `win F`.
-/

@[expose] public section

namespace PDE.NashKernelLimit

open MeasureTheory Set Filter Topology PDE.NashKernelDyadic

variable {d : ℕ}

/-- The level-`n` step kernel `P_n(x,y) = T(Q_n(y))(x) / vol(Q_n(y))`. -/
noncomputable def stepKernel (T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ) (n : ℕ) (x y : PDE.Vec d) : ℝ :=
  ((2 : ℝ) ^ n) ^ d * T n (idx n y) x

/-- The pointwise hypotheses of the abstract theorem at the point `x`. -/
def Good (M : ℝ) (T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ) (x : PDE.Vec d) : Prop :=
  ∀ n k, (0 ≤ T n k x ∧ T n k x ≤ M * (volume (cube n k)).toReal) ∧
    T n k x = ∑ ε : Fin d → Bool, T (n + 1) (child k ε) x

theorem measurable_stepKernel {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ}
    (hT : ∀ n k, Measurable (T n k)) (n : ℕ) :
    Measurable (fun p : PDE.Vec d × PDE.Vec d => stepKernel T n p.1 p.2) := by
  have h : Measurable (fun q : PDE.Vec d × (Fin d → ℤ) => T n q.2 q.1) :=
    measurable_from_prod_countable_left fun k => hT n k
  have h2 : Measurable (fun p : PDE.Vec d × PDE.Vec d => (p.1, idx n p.2)) :=
    measurable_fst.prodMk ((measurable_idx n).comp measurable_snd)
  exact measurable_const.mul (h.comp h2)

theorem measurable_stepKernel_right {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ} (n : ℕ)
    (x : PDE.Vec d) : Measurable (stepKernel T n x) :=
  measurable_const.mul ((measurable_of_countable fun k => T n k x).comp (measurable_idx n))

theorem stepKernel_const_on_cube {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ} {n : ℕ}
    {k : Fin d → ℤ} {x y : PDE.Vec d} (hy : y ∈ cube n k) :
    stepKernel T n x y = ((2 : ℝ) ^ n) ^ d * T n k x := by
  simp only [stepKernel, mem_cube_iff.mp hy]

theorem stepKernel_bounds {M : ℝ} {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ} {x : PDE.Vec d}
    (hx : Good M T x) (n : ℕ) (y : PDE.Vec d) : 0 ≤ stepKernel T n x y ∧ stepKernel T n x y ≤ M := by
  obtain ⟨⟨h0, h1⟩, -⟩ := hx n (idx n y)
  have hp : (0 : ℝ) < ((2 : ℝ) ^ n) ^ d := by positivity
  refine ⟨mul_nonneg hp.le h0, ?_⟩
  rw [volume_cube_toReal] at h1
  calc stepKernel T n x y = ((2 : ℝ) ^ n) ^ d * T n (idx n y) x := rfl
    _ ≤ ((2 : ℝ) ^ n) ^ d * (M * ((2 : ℝ) ^ n)⁻¹ ^ d) := mul_le_mul_of_nonneg_left h1 hp.le
    _ = M := by
      rw [inv_pow, mul_left_comm, mul_inv_cancel₀ hp.ne', mul_one]

theorem setIntegral_cube_stepKernel_self (T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ) (n : ℕ)
    (k : Fin d → ℤ) (x : PDE.Vec d) :
    ∫ y in cube n k, stepKernel T n x y = T n k x := by
  rw [setIntegral_congr_fun (measurableSet_cube n k) fun y hy => stepKernel_const_on_cube hy]
  rw [setIntegral_const, smul_eq_mul, Measure.real, volume_cube_toReal]
  have hp : (0 : ℝ) < ((2 : ℝ) ^ n) ^ d := by positivity
  rw [inv_pow]
  field_simp

theorem integrableOn_stepKernel {M : ℝ} {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ} {x : PDE.Vec d}
    (hx : Good M T x) (n : ℕ) {s : Set (PDE.Vec d)} (hs : volume s < ⊤) :
    IntegrableOn (stepKernel T n x) s := by
  refine Measure.integrableOn_of_bounded (M := M) hs.ne
    (measurable_stepKernel_right n x).aestronglyMeasurable (ae_of_all _ fun y => ?_)
  have := stepKernel_bounds hx n y
  rw [Real.norm_eq_abs, abs_of_nonneg this.1]
  exact this.2

theorem setIntegral_cube_stepKernel_succ {M : ℝ} {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ}
    {x : PDE.Vec d} (hx : Good M T x) (n : ℕ) (k : Fin d → ℤ) :
    ∫ y in cube n k, stepKernel T (n + 1) x y = T n k x := by
  rw [cube_succ_eq_iUnion n k]
  rw [integral_iUnion (fun ε => measurableSet_cube _ _) (pairwise_disjoint_child n k)
    (integrableOn_stepKernel hx (n + 1) (by
      rw [← cube_succ_eq_iUnion n k]; exact volume_cube_lt_top n k))]
  rw [tsum_fintype]
  simp only [setIntegral_cube_stepKernel_self]
  exact ((hx n k).2).symm

/-- The dyadic filtration: level `n` is generated by the index map `idx n`. -/
noncomputable def dyadicFiltration (d : ℕ) :
    Filtration ℕ (inferInstance : MeasurableSpace (PDE.Vec d)) where
  seq n := MeasurableSpace.comap (idx n) (inferInstance : MeasurableSpace (Fin d → ℤ))
  mono' := by
    intro n m h
    obtain ⟨g, hg⟩ := exists_idx_eq (d := d) h
    have : (idx n : PDE.Vec d → Fin d → ℤ) = g ∘ idx m := funext hg
    show MeasurableSpace.comap (idx n) _ ≤ MeasurableSpace.comap (idx m) _
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_of_countable g).comap_le
  le' n := (measurable_idx n).comap_le

theorem stronglyAdapted_stepKernel (T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ) (x : PDE.Vec d) :
    StronglyAdapted (dyadicFiltration d) fun n => stepKernel T n x := by
  intro n
  have h : Measurable (fun k : Fin d → ℤ => ((2 : ℝ) ^ n) ^ d * T n k x) :=
    measurable_of_countable _
  have h2 : Measurable[MeasurableSpace.comap (idx n) (inferInstance : MeasurableSpace (Fin d → ℤ))]
      ((fun k : Fin d → ℤ => ((2 : ℝ) ^ n) ^ d * T n k x) ∘ idx n) :=
    @Measurable.comp _ _ _ (MeasurableSpace.comap (idx n) _) _ _ _ _ h (comap_measurable _)
  exact h2.stronglyMeasurable

theorem setIntegral_inter_win_stepKernel_succ {M : ℝ} {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ}
    {x : PDE.Vec d} (hx : Good M T x) (n : ℕ) (S : Set (Fin d → ℤ)) (F : Finset (Fin d → ℤ)) :
    ∫ y in idx n ⁻¹' S ∩ win F, stepKernel T n x y =
      ∫ y in idx n ⁻¹' S ∩ win F, stepKernel T (n + 1) x y := by
  have hS : idx n ⁻¹' S ∩ win F = ⋃ k : S, (cube n k ∩ win F) := by
    ext y
    simp only [mem_inter_iff, mem_preimage, mem_iUnion, mem_cube_iff, Subtype.exists]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨idx n y, h1, rfl, h2⟩
    · rintro ⟨k, hk, h1, h2⟩; exact ⟨h1 ▸ hk, h2⟩
  have hm : ∀ k : S, MeasurableSet (cube n (k : Fin d → ℤ) ∩ win F) := fun k =>
    MeasurableSet.inter (measurableSet_cube n (k : Fin d → ℤ)) (measurableSet_win F)
  have hd : Pairwise (Function.onFun Disjoint fun k : S => cube n k ∩ win F) := by
    intro k j hkj
    have := pairwise_disjoint_cube (d := d) n (fun h => hkj (Subtype.ext h))
    exact this.mono inter_subset_left inter_subset_left
  have hfin : volume (⋃ k : S, (cube n k ∩ win F)) < ⊤ := by
    rw [← hS]; exact (measure_mono inter_subset_right).trans_lt (volume_win_lt_top F)
  rw [hS, integral_iUnion hm hd (integrableOn_stepKernel hx n hfin),
    integral_iUnion hm hd (integrableOn_stepKernel hx (n + 1) hfin)]
  refine tsum_congr fun k => ?_
  rcases cube_subset_win_or_disjoint (n := n) (k : Fin d → ℤ) F with h | h
  · rw [inter_eq_left.mpr h, setIntegral_cube_stepKernel_self,
      setIntegral_cube_stepKernel_succ hx]
  · rw [h.inter_eq]; simp

theorem martingale_stepKernel {M : ℝ} {T : ℕ → (Fin d → ℤ) → PDE.Vec d → ℝ} {x : PDE.Vec d}
    (hx : Good M T x) (F : Finset (Fin d → ℤ)) :
    have : IsFiniteMeasure (volume.restrict (win F) : Measure (PDE.Vec d)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact volume_win_lt_top F⟩
    Martingale (fun n => stepKernel T n x) (dyadicFiltration d) (volume.restrict (win F)) := by
  have : IsFiniteMeasure (volume.restrict (win F) : Measure (PDE.Vec d)) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact volume_win_lt_top F⟩
  refine martingale_of_setIntegral_eq_succ (stronglyAdapted_stepKernel T x)
    (fun n => integrableOn_stepKernel hx n (volume_win_lt_top F)) ?_
  intro n s hs
  obtain ⟨S, -, rfl⟩ := hs
  rw [Measure.restrict_restrict ((measurable_idx n) (Set.to_countable S).measurableSet)]
  exact setIntegral_inter_win_stepKernel_succ hx n S F

end PDE.NashKernelLimit
